{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update renovate remote includes version",
      "fileMatch": [
        "\\.gitlab-ci\\.ya?ml$"
      ],
      "matchStrings": [
        "-\\s+remote:\\s+https://gitlab\\.com/renovate-bot/renovate-runner/-/raw/(?<currentValue>v[0-9.]+)/"
      ],
      "datasourceTemplate": "gitlab-releases",
      "depNameTemplate": "renovate-runner",
      "packageNameTemplate": "renovate-bot/renovate-runner",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update PHP extension installer remote include version",
      "fileMatch": [
        "Dockerfile"
      ],
      "matchStrings": [
        "https://github\\.com/mlocati/docker-php-extension-installer/releases/download/(?<currentValue>[0-9.]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "mlocati/docker-php-extension-installer",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update pinned PHP base images (openssl, tracks newest Debian)",
      "fileMatch": [
        "resources-dev/php/\\d+\\.\\d+-openssl$"
      ],
      "matchStrings": [
        "(?<depName>mirror\\.gcr\\.io/php):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "php",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-cli-(?<compatibility>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update pinned PHP base images (nss/gnutls, pinned to bookworm)",
      "fileMatch": [
        "resources-dev/php/\\d+\\.\\d+-(?:nss|nss-nobignum|gnutls)$"
      ],
      "matchStrings": [
        "(?<depName>mirror\\.gcr\\.io/php):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "mirror.gcr.io/php-legacy-tls",
      "packageNameTemplate": "php",
      "versioningTemplate": "regex:^(?<compatibility>\\d+\\.\\d+)\\.(?<patch>\\d+)-cli-bookworm$"
    },
    {
      "customType": "regex",
      "description": "Update digest-pinned container images referenced in CI jsonnet (wiremock, podman, …)",
      "fileMatch": [
        "\\.(?:libsonnet|jsonnet)$"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9._/-]+):(?<currentValue>[^@'\" ]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days"
  },
  "branchConcurrentLimit": 2,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/podman/stable"
      ],
      "versioning": "regex:^v?(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?-(?<compatibility>immutable)$"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "/renovate-runner/"
      ],
      "groupName": "renovate-runner",
      "allowedVersions": "<20.0.0",
      "schedule": [
        "on the first day of the week"
      ],
      "automerge": true
    },
    {
      "description": "Group and automerge PHP base image patch updates (Debian dist upgrades are manual — dist name is the compatibility group in the regex versioning, so cross-dist updates won't be proposed).",
      "matchDepNames": ["mirror.gcr.io/php", "mirror.gcr.io/php-legacy-tls"],
      "groupName": "php-base-images",
      "automerge": true
    },
    {
      "description": "Prevent PHP minor/major version jumps within same Debian variant",
      "matchDepNames": ["mirror.gcr.io/php", "mirror.gcr.io/php-legacy-tls"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false
    },
    {
      "description": "phpstan-extension >=2.1 conflicts with azjezz/psl, which veewee/xml and the php-soap stack still require on PHP 8.1",
      "matchPackageNames": ["php-standard-library/phpstan-extension"],
      "allowedVersions": "<2.1.0"
    },
    {
      "matchDepTypes": [
        "require-dev"
      ],
      "rangeStrategy": "bump",
      "automerge": true,
      "postUpgradeTasks": {
        "commands": [
          "composer upgrade --no-scripts --ignore-platform-req=ext-* {{ lookup (split depName ':') 0 }}"
        ],
        "fileFilters": [
          "composer.lock"
        ]
      }
    }
  ],
  "constraints": {
    "php": "8.1.*"
  },
  "constraintsFiltering": "strict"
}
